# Postgres connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/overflow_inventory?schema=public"

# Auth.js (NextAuth v5) — required for login
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: public URL of the app (helpful in production)
# AUTH_URL="http://localhost:3000"

# Optional: omit DATABASE_URL to run the UI against lib/mock-data.ts fallbacks
# (login/admin still need DATABASE_URL + seed for users)
